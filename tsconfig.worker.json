{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "types": ["./worker-configuration.d.ts", "vite/client"],
    // Bundler-style resolution: the Worker is bundled by wrangler/esbuild,
    // which resolves extensionless relative imports (including shared/).
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["worker", "shared", "tests", "vitest.config.ts"]
}
